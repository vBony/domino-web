# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.

# Modo local (sem backend real): 4 assentos controlados no mesmo cliente,
# NetworkService usa mocks. Ver src/config/localMode.ts.
VITE_LOCAL_MODE=true

# URL do backend (Socket.IO) usada quando VITE_LOCAL_MODE=false.
# Ainda nao existe backend - isto e um placeholder para a integracao futura
# (Laravel + Express + Socket.IO). Ver src/config/serverUrl.ts.
VITE_SERVER_URL=http://localhost:3000
